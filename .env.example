# Copy to .env and fill in. .env is git-ignored and must never be committed
# or logged (CLAUDE.md §3).

# Alpaca — market data (1-minute bars, corporate actions) and news.
# Free account: https://alpaca.markets
ALPACA_KEY_ID=
ALPACA_SECRET_KEY=

# Finnhub — news fallback only, used when Alpaca is unavailable.
# Free tier: https://finnhub.io  (60 calls/min)
FINNHUB_API_KEY=

# Web Push (VAPID). Generate a key pair with:
#   python -c "from py_vapid import Vapid01; v=Vapid01(); v.generate_keys(); \
#              print(v.public_key, v.private_key)"
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# mailto: address or site URL identifying the push sender to the push service.
VAPID_SUBJECT=mailto:you@example.com

# Set to 1 to run the whole app on synthetic movers, news and bars so the UI,
# push, lake and missed-runner pages can be exercised outside market hours.
MOCK_DATA=0
